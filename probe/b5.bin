const A={
  bg:'assets/battlefield.webp', arthos:'assets/arthos.webp',
  friendAtlas:'assets/friend_atlas.webp', enemyAtlas:'assets/enemy_atlas.webp'
};
const CHAPTERS=[
 ['The Ashen Plains','Ruined Outpost','Black Ridge','Blood Pass','Burned Village','Demon Gate','Obsidian Keep'],
 ['Kingdom of Bones','Grave Road','Silent Abbey','Dead King\'s Bridge','Ossuary','Hollow Capital','Throne of Marrow'],
 ['The Thornwild','Hunter\'s Trail','Fang Valley','Ancient Grove','Beast Pits','Worldroot','Devourer\'s Den'],
 ['The Abyss Opens','Red Horizon','Broken Seal','Infernal March','Fallen Ravenhold','Abyss Gate','Heart of Ruin']
];
const UNITS={
 knight:{name:'Swordsman',cost:55,hp:290,atk:31,range:52,speed:95,cd:.9,atlas:'friendAtlas',atlasIndex:0,scale:1.12,unlock:1},
 spear:{name:'Spearman',cost:70,hp:330,atk:38,range:92,speed:82,cd:1.0,atlas:'friendAtlas',atlasIndex:1,scale:1.12,unlock:1},
 archer:{name:'Archer',cost:75,hp:185,atk:27,range:300,speed:84,cd:1.2,atlas:'friendAtlas',atlasIndex:2,scale:1.10,unlock:2,ranged:true},
 cavalry:{name:'Cavalry',cost:120,hp:480,atk:58,range:70,speed:132,cd:1.0,atlas:'friendAtlas',atlasIndex:3,scale:1.34,unlock:4},
 arthos:{name:'Arthos',cost:180,hp:900,atk:92,range:80,speed:112,cd:.75,atlas:'friendAtlas',atlasIndex:0,scale:1.43,hero:true},
 enemyKnight:{name:'Legionary',hp:300,atk:30,range:52,speed:88,cd:.95,atlas:'enemyAtlas',atlasIndex:0,scale:1.12},
 enemyHalberd:{name:'Halberdier',hp:310,atk:40,range:98,speed:80,cd:1.05,atlas:'enemyAtlas',atlasIndex:1,scale:1.12},
 enemyAxe:{name:'Axeman',hp:370,atk:48,range:65,speed:85,cd:1.0,atlas:'enemyAtlas',atlasIndex:2,scale:1.14},
 enemyCavalry:{name:'Dread Rider',hp:520,atk:66,range:75,speed:126,cd:1.0,atlas:'enemyAtlas',atlasIndex:3,scale:1.34}
};
const BUILDINGS=['Keep','Barracks','Archery Range','Mage Tower','Temple','Blacksmith','Market','Beast Pens','Siege Workshop'];
const HEROES=[['Arthos','Vanguard','Ashen Reckoning','Infantry attack +10%'],['Lyra','Support','Radiant Covenant','Healing +15%'],['Kael','Ranged','Arrowstorm','Ranged speed +12%'],['Morvane','Summoner','Legion of Dust','Summoned unit +1']];
const GEAR=[['Ashen Longsword','weapon','rare',350,12],['Ravenhold Plate','armour','rare',420,14],['Ember Relic','relic','epic',650,18],['Warlord Fang','weapon','epic',900,24],['Crown of Ash','relic','legendary',1400,34],['Bastion Guard','armour','legendary',1650,38]];
const fresh=()=>({gold:1500,crystals:60,ore:0,unlocked:1,selected:1,stars:{},heroLevel:1,heroXp:0,unitLvl:{knight:1,spear:1,archer:1,cavalry:1},build:Object.fromEntries(BUILDINGS.map(x=>[x,1])),inventory:[],equip:{weapon:null,armour:null,relic:null},difficulty:'Normal'});
let S=(()=>{try{return Object.assign(fresh(),JSON.parse(localStorage.getItem('warfront_final')||'{}'))}catch{return fresh()}})();
function save(){localStorage.setItem('warfront_final',JSON.stringify(S));renderResources()}
function show(id){document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));document.getElementById(id+'Screen').classList.add('active')}
function renderResources(){document.getElementById('resLeft').innerHTML=`GOLD <b>${S.gold}</b> &nbsp; ✦ CRYSTALS <b>${S.crystals}</b> &nbsp; ORE <b>${S.ore}</b>`}
const hubNav=document.getElementById('hubNav');['Campaign','Army','Heroes','Blacksmith','Ravenhold','Settings','Menu'].forEach(n=>{let b=document.createElement('button');b.textContent=n;b.onclick=()=>n==='Menu'?show('menu'):renderHub(n.toLowerCase());hubNav.appendChild(b)});
function renderHub(view){show('hub');renderResources();[...hubNav.children].forEach(b=>b.classList.toggle('active',b.textContent.toLowerCase()===view));const c=document.getElementById('hubContent');
 if(view==='campaign')renderCampaign(c); else if(view==='army')renderArmy(c); else if(view==='heroes')renderHeroes(c); else if(view==='blacksmith')renderForge(c); else if(view==='ravenhold')renderCastle(c); else renderSettings(c);}
function renderCampaign(c){c.innerHTML='<h2>CAMPAIGN</h2><div class="sub">Four chapters, twenty-four battles. Clear stages to unlock the next front.</div>';let idx=0;CHAPTERS.forEach((ch,ci)=>{c.insertAdjacentHTML('beforeend',`<div class="chapterTitle">CHAPTER ${ci+1} — ${ch[0]}</div><div class="stageGrid" id="chapter${ci}"></div>`);const g=c.querySelector('#chapter'+ci);ch.slice(1).forEach((name,si)=>{idx++;const card=document.createElement('div'),locked=idx>S.unlocked;card.className='stage '+(locked?'locked ':'')+(S.stars[idx]?'done ':'')+(S.selected===idx?'sel':'');card.innerHTML=`<div class="badge">${si===5?'BOSS':'BATTLE'}</div><h3>${idx}. ${name}</h3><div class="stars">${'★'.repeat(S.stars[idx]||0)}${'☆'.repeat(3-(S.stars[idx]||0))}</div><div class="sub">${locked?'Locked':'Available'}</div>`;if(!locked)card.onclick=()=>{S.selected=idx;save();renderCampaign(c)};g.appendChild(card)})});c.insertAdjacentHTML('beforeend',`<div class="actions"><button id="startStage" class="metal primary">START SELECTED BATTLE</button><label class="sub">Difficulty <select id="diff" style="background:#10141a;border:1px solid #765a35;padding:8px"><option>Easy</option><option>Normal</option><option>Hard</option><option>Brutal</option></select></label></div>`);c.querySelector('#diff').value=S.difficulty;c.querySelector('#diff').onchange=e=>{S.difficulty=e.target.value;save()};c.querySelector('#startStage').onclick=()=>beginStage(S.selected)}
function previewStyle(u){const y=(u.atlasIndex*2/7*100).toFixed(4);return `background-image:url('${A[u.atlas]}');background-position:0 ${y}%`}
function renderArmy(c){c.innerHTML='<h2>ARMY & UPGRADES</h2><div class="sub">Upgrade Ravenhold units with gold. Higher levels increase health and damage in battle.</div><div class="grid4" id="ug"></div>';const g=c.querySelector('#ug');for(const [k,u] of Object.entries(UNITS)){if(!['knight','spear','archer','cavalry'].includes(k))continue;let lvl=S.unitLvl[k],cost=180*lvl;let d=document.createElement('div');d.className='upgrade';d.innerHTML=`<div class="unitPreview" style="${previewStyle(u)}"></div><h3>${u.name} · Lv ${lvl}</h3><div class="stat">HP ${Math.round(u.hp*(1+.1*(lvl-1)))} · ATK ${Math.round(u.atk*(1+.09*(lvl-1)))}</div><div class="stat">Mana ${u.cost} · Unlock stage ${u.unlock}</div><button class="metal">Upgrade · ${cost} Gold</button>`;d.querySelector('button').onclick=()=>{if(S.gold<cost)return alert('Not enough gold.');S.gold-=cost;S.unitLvl[k]++;save();renderArmy(c)};g.appendChild(d)}}
function renderHeroes(c){c.innerHTML=`<h2>HEROES</h2><div class="heroLayout"><div class="heroPortrait"></div><div class="panelCard"><h2>ARTHOS — THE ASHEN BLADE</h2><div class="sub">Current campaign commander. Other heroes unlock as the campaign progresses.</div><div class="statRow"><span>Level</span><b>${S.heroLevel}</b></div><div class="statRow"><span>Experience</span><b>${S.heroXp} / ${S.heroLevel*250}</b></div><div class="statRow"><span>Ultimate</span><b>Ashen Reckoning</b></div><div class="statRow"><span>Army Bonus</span><b>Infantry ATK +10%</b></div><div style="margin-top:20px" class="grid4" id="heroCards"></div></div></div>`;const g=c.querySelector('#heroCards');HEROES.forEach((h,i)=>{let unlocked=S.unlocked>=[1,7,13,19][i];let d=document.createElement('div');d.className='upgrade '+(!unlocked?'locked':'');d.innerHTML=`<h3>${h[0]}</h3><div class="stat">${h[1]}</div><div class="stat">${h[2]}</div><div class="sub">${unlocked?h[3]:'Unlock in Chapter '+(i+1)}</div>`;g.appendChild(d)})}
function renderForge(c){c.innerHTML='<h2>BLACKSMITH</h2><div class="sub">Buy and equip weapons, armour and relics. Gear improves Arthos and the Ravenhold line.</div><div class="forgeGrid" id="forge"></div>';const g=c.querySelector('#forge');GEAR.forEach((it,i)=>{let owned=S.inventory.includes(i),eq=S.equip[it[1]]===i;let d=document.createElement('div');d.className='item '+it[2];d.innerHTML=`<h3>${it[0]}</h3><div class="stat">${it[1].toUpperCase()} · +${it[4]}% combat power</div><div class="stat">Rarity: ${it[2]}</div><button class="metal">${eq?'EQUIPPED':owned?'EQUIP':'BUY · '+it[3]+' GOLD'}</button>`;d.querySelector('button').onclick=()=>{if(!owned){if(S.gold<it[3])return alert('Not enough gold.');S.gold-=it[3];S.inventory.push(i)}S.equip[it[1]]=i;save();renderForge(c)};g.appendChild(d)})}
function renderCastle(c){c.innerHTML='<h2>RAVENHOLD</h2><div class="sub">Castle upgrades give permanent campaign bonuses and unlock advanced support.</div><div class="buildingGrid" id="bg"></div>';const g=c.querySelector('#bg');BUILDINGS.forEach((b,i)=>{let l=S.build[b],cost=250*l*(i<2?1:2);let d=document.createElement('div');d.className='item';d.innerHTML=`<h3>${b} · Lv ${l}</h3><div class="stat">Permanent bonus +${l*2}%</div><button class="metal">Upgrade · ${cost} Gold</button>`;d.querySelector('button').onclick=()=>{if(S.gold<cost)return alert('Not enough gold.');S.gold-=cost;S.build[b]++;save();renderCastle(c)};g.appendChild(d)})}
function renderSettings(c){c.innerHTML=`<h2>SETTINGS & SAVE</h2><div class="sub">Progress is saved automatically in this browser.</div><div class="panelCard" style="margin-top:18px"><div class="statRow"><span>Difficulty</span><b>${S.difficulty}</b></div><div class="statRow"><span>Campaign progress</span><b>${S.unlocked}/24 stages</b></div><div class="actions"><button class="metal" id="reset">RESET SAVE</button><button class="metal" id="export">EXPORT SAVE</button></div></div>`;c.querySelector('#reset').onclick=()=>{if(confirm('Reset all Warfront progress?')){S=fresh();save();renderSettings(c)}};c.querySelector('#export').onclick=()=>prompt('Copy your save data:',JSON.stringify(S))}
document.getElementById('continueBtn').onclick=()=>renderHub('campaign');document.getElementById('menuCampaignBtn').onclick=()=>renderHub('campaign');document.getElementById('menuArmyBtn').onclick=()=>renderHub('army');document.getElementById('newBtn').onclick=()=>{if(confirm('Start a new campaign?')){S=fresh();save();renderHub('campaign')}};
