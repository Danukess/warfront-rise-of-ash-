:root{--gold:#b88a4a;--gold2:#e2c07b;--blue:#299cf2;--red:#e0444b;--panel:#0b0e13ee;--panel2:#151b24f2;--ink:#050609;--text:#f2eadc;--muted:#b7b0a5;--green:#4cbf73}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#020305;color:var(--text);font-family:Georgia,"Times New Roman",serif}button,input,select{font:inherit;color:inherit}.hidden{display:none!important}
#app{position:relative;width:100%;height:100%;background:#05070a}.screen{position:absolute;inset:0;display:none}.screen.active{display:block}
.bg{position:absolute;inset:0;background:url('assets/battlefield.webp') center/cover no-repeat;filter:brightness(.45) saturate(.85)}.bg:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#020305ea 0 31%,#05060970 52%,#020305e2 100%)}
.metal{background:linear-gradient(#2d241a,#100c09);border:1px solid #a17742;box-shadow:inset 0 0 0 1px #fff1;color:#eee;cursor:pointer}.metal:hover{filter:brightness(1.14)}.metal.primary{background:linear-gradient(#8e2c31,#441316);border-color:#d86668}.metal:disabled{opacity:.42;cursor:not-allowed;filter:grayscale(.6)}
.menuWrap{position:relative;z-index:2;height:100%;display:grid;grid-template-columns:minmax(410px,520px) 1fr;align-items:center;padding:4.8vw}.menuPanel{padding:34px;background:linear-gradient(#12171fe9,#07090cf3);border:2px solid #9b713b;box-shadow:0 22px 60px #000c}.logo{font-size:54px;line-height:.92;letter-spacing:4px;text-shadow:0 3px #000}.logo span{display:block;color:#d64a42;font-size:18px;letter-spacing:9px;margin-top:12px}.tag{margin-top:14px;color:#d6c3a6;letter-spacing:3px;font:12px Arial}.menuBtns{display:grid;gap:11px;margin-top:28px}.menuBtns button{padding:14px 16px;text-align:left;font-weight:700}.version{margin-top:15px;color:#968b7c;font:12px Arial}
.topbar{height:74px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:14px;padding:8px 18px;background:linear-gradient(#1a2029,#080a0e);border-bottom:2px solid #8e6738;box-shadow:0 6px 20px #0008;position:relative;z-index:10}.brand{text-align:center;font-size:28px;letter-spacing:4px;font-weight:800}.brand span{display:block;color:#d64f43;font-size:12px;letter-spacing:7px}.resource{font:700 13px Arial}.right{text-align:right}.nav{display:flex;gap:7px;justify-content:flex-end;flex-wrap:wrap}.nav button{padding:8px 10px;background:#10141a;border:1px solid #745832;cursor:pointer;font:700 12px Arial}.nav button.active{border-color:#d2a35f;color:#f7ddad}.content{position:absolute;inset:74px 0 0;overflow:auto;padding:28px;background:radial-gradient(circle at 50% 0,#1a2330 0,#090b0f 55%,#050609 100%)}.section{max-width:1240px;margin:0 auto;background:#0a0d12ed;border:1px solid #795a34;padding:22px;box-shadow:0 12px 36px #0008}.section h2{margin:0 0 7px;font-size:27px;letter-spacing:2px}.sub{color:var(--muted);font:14px/1.5 Arial}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.actions button{padding:11px 15px}
.stageGrid{display:grid;grid-template-columns:repeat(3,minmax(220px,1fr));gap:14px;margin-top:20px}.stage{min-height:142px;padding:16px;background:linear-gradient(#18202a,#0b0e13);border:1px solid #6f5637;position:relative;cursor:pointer}.stage:hover{border-color:#d2a55e}.stage.locked{opacity:.38;cursor:not-allowed;filter:grayscale(.7)}.stage.done{box-shadow:inset 4px 0 var(--green)}.stage.sel{outline:2px solid #e4b967}.stage h3{margin:0 0 7px}.stars{color:#e7b353;font-size:20px}.badge{position:absolute;right:10px;top:10px;font:700 11px Arial;padding:5px 7px;border:1px solid #755832;background:#0a0c10}.chapterTitle{margin:24px 0 10px;color:#e6cfaa;letter-spacing:2px;font-size:18px}.chapterTitle:first-child{margin-top:0}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:20px}.upgrade{padding:14px;background:#11161d;border:1px solid #6f5637}.unitPreview{width:130px;height:130px;margin:0 auto 8px;background-repeat:no-repeat;background-size:auto 800%;filter:drop-shadow(0 8px 10px #000a)}.upgrade h3{margin:0}.stat{font:13px Arial;color:#cbd0d7;margin:5px 0}.upgrade button{width:100%;margin-top:8px;padding:9px}.heroLayout{display:grid;grid-template-columns:320px 1fr;gap:18px}.heroPortrait{height:470px;background:url('assets/arthos.webp') center bottom/contain no-repeat,linear-gradient(#151a22,#090b0f);border:1px solid #7d5e39}.panelCard{padding:18px;background:#11161d;border:1px solid #6f5637}.statRow{display:flex;justify-content:space-between;border-bottom:1px solid #342b20;padding:9px 0;font:14px Arial}.buildingGrid,.forgeGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}.item{padding:15px;background:#11161d;border:1px solid #6f5637}.item h3{margin:0 0 5px}.item button{width:100%;padding:9px;margin-top:8px}.equip{color:#7fd5ff}.rare{border-color:#387fce}.epic{border-color:#8f53d9}.legendary{border-color:#d59a35}
#battleScreen{background:#030405}.battleGrid{height:100%;display:grid;grid-template-rows:74px minmax(0,1fr) 184px}.battleTop{height:74px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:18px;padding:8px 20px;background:linear-gradient(#171d25,#07090d);border-bottom:2px solid #8f6636;z-index:6}.faction{font:800 14px Arial;letter-spacing:1.2px}.hpTrack{height:16px;margin-top:6px;background:#06080b;border:2px solid #806039;padding:2px}.hpFill{height:100%;transition:width .2s}.hpFill.blue{background:linear-gradient(90deg,#145b9e,#3eb6ff)}.hpFill.red{margin-left:auto;background:linear-gradient(90deg,#8e1118,#ff4b54)}.battleBrand{text-align:center;font-size:28px;letter-spacing:4px}.battleBrand span{display:block;color:#d84d45;font-size:11px;letter-spacing:7px}.battleArea{position:relative;min-height:0;overflow:hidden;background:#090b0f}.battleArea canvas{position:absolute;inset:0;width:100%;height:100%;display:block}.stageHud{position:absolute;z-index:4;left:50%;top:14px;transform:translateX(-50%);min-width:430px;padding:9px 18px;text-align:center;background:#07090de8;border:2px solid #98703d;box-shadow:0 6px 18px #0009}.stageHud strong{letter-spacing:1px}.stageHud small{display:block;margin-top:3px;font:13px Arial;color:#d9dde4}.mana{color:#59bcff}.sideControls{position:absolute;left:16px;top:110px;z-index:4;display:grid;gap:8px}.sideControls button{width:50px;height:48px;background:#0c0f14dc;border:1px solid #9a713c;cursor:pointer}.sideControls button.active{background:#5c2b16}.battleBottom{display:grid;grid-template-columns:minmax(0,1fr) 320px;background:linear-gradient(#0a0c10,#050609);border-top:2px solid #91683a;min-height:0}.unitBar{display:flex;gap:10px;padding:11px 14px;overflow-x:auto}.unitCard{position:relative;min-width:132px;width:132px;height:158px;padding:6px;background:linear-gradient(#1b2129,#0a0c10);border:2px solid #80613c;cursor:pointer;display:grid;grid-template-rows:94px auto auto;align-items:center;text-align:center}.unitCard:hover{border-color:#d3a65f}.unitCard.disabled{opacity:.42;filter:grayscale(.55)}.unitArt{width:92px;height:92px;margin:auto;background-repeat:no-repeat;background-size:auto 800%;filter:drop-shadow(0 7px 8px #000a)}.unitName{font:700 14px Arial}.cost{font:700 12px Arial;color:#67c2ff}.hotkey{position:absolute;left:5px;top:5px;width:22px;height:22px;background:#090b0f;border:1px solid #725735;font:700 11px/20px Arial}.commandPanel{padding:11px 13px;border-left:1px solid #3b2d20;display:grid;grid-template-rows:auto auto auto 1fr;gap:9px}.stats{display:grid;grid-template-columns:1fr 1fr;gap:5px;font:700 12px Arial;color:#d3d7de}.commands{display:grid;grid-template-columns:1fr 1fr;gap:7px}.commands button{padding:11px 5px;background:linear-gradient(#2c2118,#100c09);border:1px solid #9a713f;cursor:pointer;font:700 13px Arial}.commands button.active{background:linear-gradient(#8c2e32,#441418);border-color:#db6669}.spell{padding:11px 7px;background:linear-gradient(#984a18,#3c1707);border:1px solid #d18b50;cursor:pointer;font:700 14px Arial}.log{background:#07090d;border:1px solid #30251b;padding:7px;overflow:auto;font:12px/1.35 Arial;color:#bec6d1}.battleOverlay{position:absolute;inset:0;z-index:8;background:radial-gradient(circle at center,#0b0e1435,#020305e8);display:grid;place-items:center}.battlePanel{width:min(650px,82vw);padding:24px;text-align:center;background:#090c11f3;border:2px solid #9c723d;box-shadow:0 18px 60px #000c}.battlePanel h1{font-size:40px;letter-spacing:3px;margin:0}.battlePanel h1 span{display:block;font-size:13px;letter-spacing:8px;color:#dc5949;margin-top:6px}.battlePanel p{font:15px/1.5 Arial;color:#d5d8de}.battlePanel button{padding:12px 18px}.flash{position:absolute;inset:0;pointer-events:none;opacity:0;background:radial-gradient(circle at 65% 65%,#fff5a855 0,#ff7c2244 16%,transparent 55%);z-index:3}.toast{position:absolute;z-index:6;right:18px;top:18px;background:#07090de8;border:1px solid #9c7440;padding:10px 14px;font:700 13px Arial;opacity:0;transform:translateY(-7px);transition:.2s}.toast.on{opacity:1;transform:none}.bossName{color:#ff8f8f;font-weight:700}.dev{position:absolute;right:12px;bottom:12px;z-index:7;padding:7px 9px;background:#0a0c10;border:1px solid #7f5c33;cursor:pointer;font:11px Arial}.devPanel{position:absolute;right:12px;bottom:50px;z-index:7;width:290px;background:#080a0eef;border:1px solid #8f6838;padding:10px;display:none}.devPanel.on{display:block}.devPanel button{margin:3px;padding:6px 8px;background:#151a21;border:1px solid #6e5334;cursor:pointer;font:11px Arial}
@media(max-width:1100px){.grid4{grid-template-columns:repeat(2,1fr)}.buildingGrid,.forgeGrid{grid-template-columns:repeat(2,1fr)}.stageGrid{grid-template-columns:repeat(2,1fr)}.battleGrid{grid-template-rows:68px minmax(0,1fr) 196px}.battleTop{height:68px}.battleBottom{grid-template-columns:minmax(0,1fr) 280px}.unitCard{min-width:116px;width:116px}.stageHud{min-width:330px}.menuWrap{grid-template-columns:minmax(350px,480px) 1fr}}
