const canvas=document.getElementById('battle'),ctx=canvas.getContext('2d');const IMG={};let game=null,last=performance.now();const frameSets={idle:[0,1],walk:[2,3],attack:[4,5],hurt:[6],dead:[7]};
function loadImage(src){return new Promise((res,rej)=>{let i=new Image();i.onload=()=>res(i);i.onerror=rej;i.src=src})}
async function loadAssets(){for(const[k,v]of Object.entries(A))IMG[k]=await loadImage(v)}
const waves=[['enemyKnight','enemyKnight','enemyHalberd','enemyKnight'],['enemyKnight','enemyHalberd','enemyAxe','enemyKnight','enemyHalberd'],['enemyAxe','enemyKnight','enemyCavalry','enemyHalberd','enemyKnight'],['enemyHalberd','enemyAxe','enemyCavalry','enemyKnight','enemyAxe','enemyHalberd'],['enemyCavalry','enemyAxe','enemyHalberd','enemyCavalry','enemyKnight'],['enemyCavalry','enemyAxe','enemyHalberd','enemyCavalry','enemyAxe','enemyKnight','enemyHalberd']];
function stageMeta(n){let ch=Math.floor((n-1)/6),si=(n-1)%6;return{chapter:ch,name:CHAPTERS[ch][si+1],boss:si===5}}
function difficultyMul(){return{Easy:.82,Normal:1,Hard:1.22,Brutal:1.5}[S.difficulty]||1}
function beginStage(n){if(n>S.unlocked)return;show('battle');const m=stageMeta(n);document.getElementById('battleStage').textContent=`CHAPTER ${m.chapter+1} — ${m.name.toUpperCase()}`;document.getElementById('difficulty').textContent=S.difficulty.toUpperCase();game={stage:n,started:false,paused:false,over:false,speed:1,order:'assault',mana:220,maxMana:500,wave:1,queue:[...waves[0]],nextSpawn:1.4,spawnGap:1.75,php:3600,ehp:3600*(m.boss?1.25:1),maxPhp:3600,maxEhp:3600*(m.boss?1.25:1),units:[],shots:[],fx:[],kills:0,gold:0,heroReady:true,cool:{},spellCd:0,boss:m.boss};renderUnitBar();battlePanel(`<h1>${m.name.toUpperCase()}<span>${m.boss?'BOSS BATTLE':'THE ASHEN WAR'}</span></h1><p>${m.boss?'Break the enemy commander and shatter the fortress line.':'Deploy Ravenhold units, survive six waves, and destroy the Obsidian stronghold.'}</p><button id="fight" class="metal primary">BEGIN BATTLE</button>`);document.getElementById('fight').onclick=()=>{game.started=true;document.getElementById('battleOverlay').style.display='none';blog('Battle begins.');};updateBattleHud()}
function battlePanel(html){document.getElementById('battlePanel').innerHTML=html;document.getElementById('battleOverlay').style.display='grid'}
function blog(t){let e=document.getElementById('battleLog'),d=document.createElement('div');d.textContent='• '+t;e.prepend(d);while(e.children.length>14)e.lastChild.remove()}
function toast(t){let e=document.getElementById('toast');e.textContent=t;e.classList.add('on');clearTimeout(e._t);e._t=setTimeout(()=>e.classList.remove('on'),1000)}
function renderUnitBar(){let b=document.getElementById('unitBar');b.innerHTML='';[['knight','1'],['spear','2'],['archer','3'],['cavalry','4']].forEach(([k,h])=>{let u=UNITS[k],card=document.createElement('div');card.className='unitCard';card.id='card-'+k;card.innerHTML=`<div class="hotkey">${h}</div><div class="unitArt" style="${previewStyle(u)}"></div><div class="unitName">${u.name}</div><div class="cost">${u.cost} MANA · Lv ${S.unitLvl[k]}</div>`;card.onclick=()=>deploy(k);b.appendChild(card)})}
function unitStats(k){let d=UNITS[k],lvl=S.unitLvl[k]||1,gear=Object.values(S.equip).filter(x=>x!==null).reduce((s,i)=>s+(GEAR[i]?.[4]||0),0)/100,hero=S.heroLevel;return{...d,hp:d.hp*(1+.10*(lvl-1)+gear*.45),atk:d.atk*(1+.09*(lvl-1)+gear+hero*.012)}}
function spawn(team,key,x,y){let d=team==='player'&&['knight','spear','archer','cavalry'].includes(key)?unitStats(key):{...UNITS[key]};if(team==='enemy'){let mul=difficultyMul()*(1+(game.stage-1)*.025);d.hp*=mul;d.atk*=mul}let u={team,key,x,y,hp:d.hp,maxHp:d.hp,atk:d.atk,range:d.range,speed:d.speed,cd:d.cd,cool:0,state:'walk',anim:0,dead:false,death:1.1,stun:0,scale:d.scale,ranged:d.ranged||false,hero:d.hero||false};game.units.push(u);return u}
function deploy(k){if(!game?.started||game.over)return;let d=UNITS[k];if(game.mana<d.cost)return toast('Not enough mana');if((game.cool[k]||0)>0)return;game.mana-=d.cost;game.cool[k]=k==='cavalry'?1.3:.55;spawn('player',k,120,625+(Math.random()-.5)*48);blog('Deployed '+d.name);updateBattleHud()}
function deployHero(){if(!game?.started||game.over)return;if(!game.heroReady)return toast('Arthos is already fighting');if(game.mana<UNITS.arthos.cost)return toast('Need 180 mana');game.mana-=UNITS.arthos.cost;game.heroReady=false;spawn('player','arthos',100,625);blog('Arthos enters the battle!')}
function enemySpawn(){if(!game.queue.length)return;let key=game.queue.shift();let u=spawn('enemy',key,1480,625+(Math.random()-.5)*48);if(game.boss&&game.wave===6&&game.queue.length===0){u.maxHp*=2.1;u.hp=u.maxHp;u.atk*=1.45;u.scale*=1.15;blog('Obsidian Warlord enters the field!')}}
function meteor(){if(!game?.started||game.over)return;if(game.mana<180)return toast('Need 180 mana');if(game.spellCd>0)return toast('Meteor recharging');game.mana-=180;game.spellCd=7;let f=document.getElementById('flash');f.style.opacity=1;setTimeout(()=>f.style.opacity=0,260);game.units.filter(u=>u.team==='enemy'&&!u.dead).forEach(u=>{u.hp-=140+Math.random()*65;burst(u.x,u.y-100,'#ff8b3c',10);if(u.hp<=0)kill(u)});blog('Meteor Rain devastates the enemy line.')}
function burst(x,y,c,n){for(let i=0;i<n;i++)game.fx.push({x,y,vx:(Math.random()-.5)*140,vy:-30-Math.random()*150,life:.55+Math.random()*.5,c,size:2+Math.random()*4})}
function kill(u){if(u.dead)return;u.dead=true;u.state='dead';u.anim=0;u.death=1.15;burst(u.x,u.y-75,u.team==='player'?'#7ec6ff':'#ff7070',8);if(u.team==='enemy'){game.kills++;game.gold+=12;if(Math.random()<.18)game.mana=Math.min(game.maxMana,game.mana+8)}if(u.hero)game.heroReady=true}
function setOrder(o){if(!game)return;game.order=o;document.getElementById('orderText').textContent=o[0].toUpperCase()+o.slice(1);document.querySelectorAll('[data-order]').forEach(b=>b.classList.toggle('active',b.dataset.order===o));blog('Order: '+o.toUpperCase())}
document.querySelectorAll('[data-order]').forEach(b=>b.onclick=()=>setOrder(b.dataset.order));document.getElementById('heroBtn').onclick=deployHero;document.getElementById('meteorBtn').onclick=meteor;document.querySelectorAll('[data-speed]').forEach(b=>b.onclick=()=>{game.speed=+b.dataset.speed;document.querySelectorAll('[data-speed]').forEach(x=>x.classList.toggle('active',x===b))});document.getElementById('pause').onclick=()=>{if(game)game.paused=!game.paused};
document.addEventListener('keydown',e=>{if(!document.getElementById('battleScreen').classList.contains('active'))return;if(['1','2','3','4'].includes(e.key))deploy(['knight','spear','archer','cavalry'][+e.key-1]);if(e.key.toLowerCase()==='q')deployHero();if(e.key.toLowerCase()==='w')meteor();if(e.key.toLowerCase()==='a')setOrder('assault');if(e.key.toLowerCase()==='s')setOrder('hold');if(e.key.toLowerCase()==='d')setOrder('retreat');if(e.code==='Space'){e.preventDefault();game.paused=!game.paused}});
function updateBattleHud(){if(!game)return;document.getElementById('php').style.width=Math.max(0,100*game.php/game.maxPhp)+'%';document.getElementById('ehp').style.width=Math.max(0,100*game.ehp/game.maxEhp)+'%';document.getElementById('mana').textContent=Math.floor(game.mana);document.getElementById('wave').textContent=game.wave+'/6';document.getElementById('battleGold').textContent=game.gold;document.getElementById('kills').textContent=game.kills;document.getElementById('unitCount').textContent=game.units.filter(u=>u.team==='player'&&!u.dead).length;['knight','spear','archer','cavalry'].forEach(k=>document.getElementById('card-'+k)?.classList.toggle('disabled',game.mana<UNITS[k].cost||(game.cool[k]||0)>0))}
function drawBg(){ctx.drawImage(IMG.bg,0,0,canvas.width,canvas.height);let g=ctx.createLinearGradient(0,0,0,canvas.height);g.addColorStop(0,'rgba(0,0,0,.02)');g.addColorStop(.55,'rgba(0,0,0,.04)');g.addColorStop(1,'rgba(0,0,0,.38)');ctx.fillStyle=g;ctx.fillRect(0,0,canvas.width,canvas.height);ctx.fillStyle='rgba(10,8,7,.18)';ctx.fillRect(0,565,canvas.width,155);ctx.strokeStyle='rgba(220,179,104,.14)';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(0,610);ctx.lineTo(canvas.width,610);ctx.stroke()}
function drawUnit(u,dt){const def=UNITS[u.key],im=IMG[def.atlas],fw=140,fh=140,state=u.dead?'dead':u.state,frames=frameSets[state]||frameSets.idle,dur=state==='attack'?.16:state==='walk'?.23:.42;u.anim+=dt;const ix=frames[Math.min(frames.length-1,Math.floor(u.anim/dur)%frames.length)],sx=(ix%4)*fw,sy=def.atlasIndex*280+Math.floor(ix/4)*fh,dw=fw*u.scale,dh=fh*u.scale;ctx.save();if(u.team==='enemy'){ctx.translate(u.x,u.y);ctx.scale(-1,1);ctx.translate(-u.x,-u.y)}ctx.globalAlpha=u.dead?Math.max(0,u.death/1.15):1;ctx.fillStyle='rgba(0,0,0,.35)';ctx.beginPath();ctx.ellipse(u.x,u.y+5,dw*.20,dw*.060,0,0,Math.PI*2);ctx.fill();ctx.drawImage(im,sx,sy,fw,fh,u.x-dw/2,u.y-dh+18,dw,dh);ctx.restore();if(!u.dead&&u.hp<u.maxHp){const bw=Math.max(42,dw*.48),by=u.y-dh+7,bx=u.x-bw/2;ctx.fillStyle='#07080cdd';ctx.fillRect(bx,by,bw,6);ctx.fillStyle=u.team==='player'?'#42b2ff':'#ff545b';ctx.fillRect(bx,by,bw*Math.max(0,u.hp/u.maxHp),6)}}
function updateBattle(dt){if(!game?.started||game.paused||game.over)return;dt*=game.speed;game.mana=Math.min(game.maxMana,game.mana+dt*17);game.spellCd=Math.max(0,game.spellCd-dt);Object.keys(game.cool).forEach(k=>game.cool[k]=Math.max(0,game.cool[k]-dt));game.nextSpawn-=dt;if(game.nextSpawn<=0&&game.queue.length){enemySpawn();game.nextSpawn=game.spawnGap*(.85+Math.random()*.3)}let ps=game.units.filter(u=>u.team==='player'&&!u.dead),es=game.units.filter(u=>u.team==='enemy'&&!u.dead);for(let u of game.units){if(u.dead){u.death-=dt;continue}u.cool=Math.max(0,u.cool-dt);u.stun=Math.max(0,u.stun-dt);let pool=u.team==='player'?es:ps,near=null,dist=1e9;for(let o of pool){let d=Math.abs(o.x-u.x);if(d<dist){dist=d;near=o}}let dir=u.team==='player'?1:-1,castle=u.team==='player'?1515:85,stop=game.order==='hold'?690:game.order==='retreat'?300:2000;if(near&&dist<=u.range+(u.ranged?35:0)){u.state='attack';if(u.cool<=0&&u.stun<=0){u.anim=0;u.cool=u.cd;if(u.ranged){game.shots.push({team:u.team,target:near,x:u.x+dir*20,y:u.y-100,vx:dir*580,vy:-5,atk:u.atk})}else{near.hp-=u.atk;near.stun=.06;burst(near.x,near.y-85,u.team==='player'?'#9bd3ff':'#ff8585',4);if(near.hp<=0)kill(near)}}}else{if(u.team==='player'&&game.order==='hold'&&u.x>=stop){u.state='idle'}else if(u.team==='player'&&game.order==='retreat'&&u.x>stop){u.state='walk';u.x-=u.speed*dt}else{u.state='walk';u.x+=dir*u.speed*dt}if((u.team==='player'&&u.x>=castle)||(u.team==='enemy'&&u.x<=castle)){u.state='attack';if(u.cool<=0){u.cool=u.cd;if(u.team==='player')game.ehp-=u.atk;else game.php-=u.atk;burst(castle,u.y-65,'#ffa33a',4)}}}}
 for(let i=game.shots.length-1;i>=0;i--){let p=game.shots[i];p.x+=p.vx*dt;p.y+=p.vy*dt;let t=p.target;if(!t||t.dead){game.shots.splice(i,1);continue}if(Math.abs(p.x-t.x)<24){t.hp-=p.atk;burst(t.x,t.y-85,'#dceaff',3);if(t.hp<=0)kill(t);game.shots.splice(i,1)}}game.units=game.units.filter(u=>!u.dead||u.death>0);
 if(!game.queue.length&&!game.units.some(u=>u.team==='enemy'&&!u.dead)){if(game.wave<6){game.wave++;game.queue=[...waves[game.wave-1]];game.nextSpawn=2.0;game.spawnGap=Math.max(1.1,game.spawnGap-.1);game.mana=Math.min(game.maxMana,game.mana+80);toast('Wave '+game.wave);blog('Wave '+game.wave+' begins.')}else endBattle(true)}if(game.php<=0)endBattle(false);if(game.ehp<=0)endBattle(true);updateBattleHud()}
function drawShots(){ctx.lineWidth=3;for(let p of game?.shots||[]){ctx.strokeStyle=p.team==='player'?'#e8f2ff':'#ffb0a0';ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(p.x-p.vx*.035,p.y-p.vy*.035);ctx.stroke()}}
function drawFx(dt){if(!game)return;for(let i=game.fx.length-1;i>=0;i--){let p=game.fx[i];p.life-=dt;if(p.life<=0){game.fx.splice(i,1);continue}p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=200*dt;ctx.globalAlpha=Math.max(0,p.life);ctx.fillStyle=p.c;ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1}}
function endBattle(win){if(game.over)return;game.over=true;if(win){let hpPct=game.php/game.maxPhp,stars=hpPct>.75?3:hpPct>.4?2:1,reward=350+game.stage*45+game.gold;S.gold+=reward;S.crystals+=game.boss?8:2;S.ore+=game.boss?1:0;S.stars[game.stage]=Math.max(S.stars[game.stage]||0,stars);S.unlocked=Math.max(S.unlocked,Math.min(24,game.stage+1));S.heroXp+=120+game.stage*15;while(S.heroXp>=S.heroLevel*250){S.heroXp-=S.heroLevel*250;S.heroLevel++}save();battlePanel(`<h1>VICTORY<span>RAVENHOLD ADVANCES</span></h1><p>${stars}★ victory · ${game.kills} kills · ${reward} gold earned.</p><button id="backHub" class="metal primary">RETURN TO CAMPAIGN</button>`)}else battlePanel(`<h1>DEFEAT<span>THE LEGION HOLDS</span></h1><p>Ravenhold has been forced back. Upgrade your army and strike again.</p><button id="retry" class="metal primary">RETRY BATTLE</button> <button id="backHub" class="metal">RETURN</button>`);document.getElementById('backHub').onclick=()=>renderHub('campaign');document.getElementById('retry')?.addEventListener('click',()=>beginStage(game.stage))}
function frame(now){let dt=Math.min(.033,(now-last)/1000);last=now;if(document.getElementById('battleScreen').classList.contains('active')){drawBg();updateBattle(dt);if(game){[...game.units].sort((a,b)=>a.y-b.y||a.x-b.x).forEach(u=>drawUnit(u,dt));drawShots();drawFx(dt)}}requestAnimationFrame(frame)}
document.getElementById('devBtn').onclick=()=>document.getElementById('devPanel').classList.toggle('on');document.querySelectorAll('[data-cheat]').forEach(b=>b.onclick=()=>{if(!game)return;if(b.dataset.cheat==='mana')game.mana=500;if(b.dataset.cheat==='win')game.ehp=0;if(b.dataset.cheat==='gold'){S.gold+=5000;save()}if(b.dataset.cheat==='unlock'){S.unlocked=24;save()}updateBattleHud()});
loadAssets().then(()=>{renderResources();requestAnimationFrame(frame)}).catch(e=>{console.error(e);alert('Warfront asset loading failed. Refresh the page.')});
